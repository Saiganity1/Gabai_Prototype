{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd gabai && npm install && npm run build",
  "outputDirectory": "gabai/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!assets/|favicon.ico|robots.txt|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
