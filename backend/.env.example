# GABAI Production Environment Variables

# Server Configuration
PORT=3000
NODE_ENV=production
CORS_ORIGINS=http://localhost:5173,http://localhost:8443,https://gabai.ph

# Database Connection (PostgreSQL)
# e.g., Supabase, Neon, AWS RDS, Railway, or local Postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/gabai?schema=public

# Google Gemini AI API Key
AI_API_KEY=your_gemini_api_key_here

# JWT Authentication Secret
JWT_SECRET=gabai-production-secret-disaster-key-2026

# Optional Routing & SMS Provider keys
# MAPBOX_API_KEY=your_mapbox_key_here
# SEMAPHORE_SMS_API_KEY=your_ph_sms_key_here
